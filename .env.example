# SQLite by default — zero setup, just a local file. To use PostgreSQL
# instead (e.g. for production), change the "provider" in prisma/schema.prisma
# to "postgresql" and set this to a real connection string.
DATABASE_URL="file:./dev.db"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Click (test mode)
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
CLICK_TEST_MODE="true"

# Payme (test mode)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_MODE="true"

# Email (no longer used — kept only in case you want to re-enable it later).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="StyleHub <no-reply@stylehub.uz>"

# SMS (registration verification code, via Twilio). Leave blank to just
# print the code to the backend console instead of sending it.
# Sign up: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

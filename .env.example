# SQLite by default — zero setup, just a local file. To use PostgreSQL
# instead (e.g. for production), change the "provider" in prisma/schema.prisma
# to "postgresql" and set this to a real connection string.
DATABASE_URL="file:./dev.db"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

# JWT
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# Click (test mode)
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
CLICK_TEST_MODE="true"

# Payme (test mode)
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
PAYME_TEST_MODE="true"

# Email (no longer used — kept only in case you want to re-enable it later).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Wardrobe <no-reply@wardrobe.uz>"

# SMS (registration verification code). Tried in this order: DevSMS
# (DEVSMS_API_TOKEN) -> own SMS Gateway phone (SMS_GATEWAY_*) -> Eskiz.uz
# (ESKIZ_EMAIL/ESKIZ_PASSWORD) -> Twilio (TWILIO_*). Leave everything blank
# to just print the code to the backend console (useful for local dev
# without any real SMS account).

# DevSMS (https://devsms.uz) — Uzbek SMS gateway, auth is a single Bearer
# token (no email/password login step). Get the token from your DevSMS
# dashboard/account. DEVSMS_FROM is the sender nickname shown on the SMS;
# leave it as "4546" unless DevSMS has approved a custom one for you.
DEVSMS_API_TOKEN=""
DEVSMS_FROM="4546"

# "SMS Gateway for Android" (https://sms-gate.app) — sends SMS through your
# OWN phone's own SIM/number, no third-party SMS API involved. Install the
# app on a phone, turn on "Local Server" mode and go online — it then shows
# the phone's local IP + port (default 8080) and a username/password for
# Basic Auth. The phone and this backend must be on the SAME local network
# (e.g. same Wi-Fi/router). Example: SMS_GATEWAY_BASE_URL="http://192.168.1.50:8080"
SMS_GATEWAY_BASE_URL=""
SMS_GATEWAY_USERNAME=""
SMS_GATEWAY_PASSWORD=""

# Eskiz.uz (https://eskiz.uz) — the standard SMS gateway for Uzbek numbers.
# Sign up in the Eskiz dashboard, then use that account's email/password
# here (NOT a public/private key pair — Eskiz's API trades email+password
# for a Bearer token). ESKIZ_FROM is the sender nickname shown on the SMS;
# leave it as "4546" (Eskiz's shared/test nickname) until your own
# nickname is approved by Eskiz support.
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"

# Twilio — alternative provider, used only if the Eskiz vars above are
# blank. Sign up: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Telegram — to'lov/buyurtma boti (chek skrinshotlarini shu bot orqali
# qabul qiladi). @BotFather -> /newbot -> token shu yerga.
# Admin chat ID: @userinfobot ga yozing, u "Id: 123456789" deb javob beradi.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_BOT_USERNAME=""

# Ombor (stock) boti — magazinchilar sotilgan tovarni belgilab, saytdagi
# qoldiqni kamaytiradi. TELEGRAM_BOT_TOKEN bilan BIR XIL bo'lmasligi kerak —
# @BotFather'da YANGI /newbot yarating, aks holda ikkala funksiya bir
# tokenda ishlay olmaydi (Telegram 409 xatosi).
TELEGRAM_STOCK_BOT_TOKEN=""

# Yordam (Contact) sahifasi boti — saytdagi "Yordam" formasidan yuborilgan
# xabarlar shu bot orqali TELEGRAM_ADMIN_CHAT_ID'ga boradi, to'lov botidan
# ALOHIDA chatda. Bu ham @BotFather'da YANGI /newbot bilan yaratiladi (yana
# boshqa tokenlar bilan bir xil bo'lmasin). Bo'sh qoldirsangiz — Yordam
# xabarlari eski holatdagidek to'lov botiga boradi.
TELEGRAM_SUPPORT_BOT_TOKEN=""

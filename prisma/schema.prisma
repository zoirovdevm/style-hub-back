generator client {
  provider = "prisma-client-js"
}

// Using SQLite for local development: zero setup, no account/signup, no
// server to install — the database is just a file (prisma/dev.db) created
// automatically by `prisma migrate dev`. To move to PostgreSQL later
// (e.g. for production): change provider to "postgresql", set DATABASE_URL
// to a real connection string, and re-run `prisma migrate dev`. At that
// point you can also switch the "string" workaround fields below
// (roles/statuses, sizes/colors/images, rawPayload) back to native
// `enum` and `Json`/`String[]` types, since Postgres supports both —
// SQLite's Prisma connector does not support either, which is why this
// schema uses plain strings everywhere instead.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────
// Models
//
// Role / OrderStatus / PaymentMethod / PaymentStatus are NOT Prisma enums
// here (SQLite's connector doesn't support `enum`) — they're plain String
// columns. The actual enum types (with validation) live in
// src/common/enums/*.enum.ts and are what GraphQL and class-validator use;
// Prisma just stores whatever string value those enums produce.
// ──────────────────────────────

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  firstName    String
  lastName     String?
  avatar       String?
  address      String?
  role         String    @default("USER")
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Phone verification — legacy path only now. Registration itself verifies
  // the phone (via PhoneOtp below) *before* the account row is even
  // created, so new accounts are always created with phoneVerified: true.
  // These three fields, and verifyEmail/resendVerificationCode in
  // auth.service.ts, are kept only so any pre-existing account created
  // under the old "create-first-then-verify" flow can still finish
  // verifying — nothing new writes to them.
  phoneVerified             Boolean   @default(false)
  verificationCode          String?
  verificationCodeExpiresAt DateTime?

  // Email verification — tracked per the data model spec, but there's no
  // OTP/verification flow for it (registration deliberately never emails a
  // code — see PhoneOtp/auth.service.ts). Reserved for a future flow.
  emailVerified Boolean @default(false)

  // Forgot-password / SMS OTP flow — separate fields from the registration
  // code above so an in-flight password reset can never interfere with (or
  // be confused with) phone verification state.
  resetCode          String?
  resetCodeExpiresAt DateTime?

  // Forgot-password / email-link flow — a single-use opaque token embedded
  // in the emailed reset URL (?token=...), distinct from resetCode above
  // (which is a 6-digit code entered by hand on the SMS path). Whichever of
  // the two the requester's identifier resolves to is the only one ever
  // set for a given reset request.
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  orders        Order[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  reviews       Review[]

  @@map("users")
}

// Holds an SMS OTP for a phone number that is *mid-registration* and has no
// User row yet (email/password/name aren't collected until after the phone
// step succeeds, and User.email is a required unique column, so a
// placeholder User can't be created early the way the old flow did).
// One row per phone — a fresh send overwrites the previous code/attempts
// rather than accumulating rows. Cleaned up once register() succeeds; a
// stale unverified row is otherwise harmless and just gets overwritten by
// the next send for that number.
model PhoneOtp {
  id         String    @id @default(uuid())
  phone      String    @unique
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("phone_otps")
}

model Category {
  id          String   @id @default(uuid())
  name        String
  nameRu      String?
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

// "Magazin" — tashqi do'kon/yetkazib beruvchi (masalan, Ko'k Saroy bozoridagi
// bir magazin). Har bir tovar ixtiyoriy ravishda bitta magazinga bog'lanadi —
// bu faqat admin panelda ko'rinadi (tovar qaysi magazindan olinganini
// kuzatish uchun), saytdagi xaridorlarga ko'rsatilmaydi.
model Store {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  // Ombor botiga kirish uchun maxfiy kod — admin buni faqat shu
  // magazinchiga beradi. Kod kiritilgach magazinchining Telegram akkaunti
  // shu magazinga biriktiriladi (TelegramStoreLink) va u boshqa
  // magazinlarni umuman ko'rmaydi.
  accessCode String? @unique
  // Admin shu magazinchi bilan qancha foizga ("komissiya") ishlashini
  // belgilaydi (masalan 20 — degani tushumning 20% adminga tegadi).
  // Magazin sahifasidagi "Mening ulushim" raqami shu foiz asosida
  // (revenue * commissionPercent / 100) hisoblanadi — store.service.ts
  // dagi computeStats() ga qarang.
  commissionPercent Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  deductions    StockDeduction[]
  telegramLinks TelegramStoreLink[]

  @@map("stores")
}

// Magazinchining Telegram akkaunti <-> magazin bog'lanishi. Bitta Telegram
// akkaunt faqat bitta magazinga ulanadi; bitta magazinga bir nechta
// sotuvchi ulanishi mumkin. Admin panelda "sotuvchilarni uzish" bosilsa
// shu yozuvlar o'chadi va ular qayta kod kiritishi kerak bo'ladi.
model TelegramStoreLink {
  id               String   @id @default(uuid())
  telegramUserId   String   @unique
  telegramUsername String?
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([storeId])
  @@map("telegram_store_links")
}

// Telegram bot orqali magazinchi "men bu tovardan N dona sotib yubordim"
// deb belgilaganda yoziladigan tarix. Ombordagi qoldiq shu zahoti
// kamaytiriladi; bu jadval esa kim, qachon, qaysi magazindan nimani
// ayirganini keyin tekshirish uchun saqlanadi.
model StockDeduction {
  id        String   @id @default(uuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  quantity  Int
  // Botda kim bajargani (Telegram foydalanuvchi ma'lumotlari)
  telegramUserId   String?
  telegramUsername String?
  createdAt DateTime @default(now())

  @@index([storeId])
  @@map("stock_deductions")
}

model Product {
  id              String   @id @default(uuid())
  title           String
  titleRu         String?
  slug            String   @unique
  description     String?
  descriptionRu   String?
  sku             String   @unique
  price           Float
  oldPrice        Float?
  discountPercent Int?
  stock           Int      @default(0)
  // JSON-encoded string arrays, e.g. ["S","M","L"] — see product.service.ts
  // for the serialize/deserialize helpers (SQLite has no native array/Json type).
  sizes           String   @default("[]")
  colors          String   @default("[]")
  images          String   @default("[]")
  // JSON-encoded [{ color, images: string[] }] — per-color product photos
  // (admin-uploaded). When a color has no entry here (or an empty images
  // list), the storefront falls back to the general `images` above.
  colorImages     String   @default("[]")
  // Kimga mo'ljallangan: MALE / FEMALE / UNISEX (src/common/enums/gender.enum.ts).
  // Mavjud tovarlar UNISEX bilan boshlanadi — admin xohlaganini keyin
  // Erkaklar/Ayollar'ga qayta belgilaydi.
  gender          String   @default("UNISEX")
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  rating          Float    @default(0)
  reviewsCount    Int      @default(0)
  viewCount       Int      @default(0)
  soldCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  // Qaysi magazindan olingan (faqat admin uchun; ixtiyoriy)
  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  variants      ProductVariant[]
  reviews       Review[]
  deductions    StockDeduction[]

  @@index([categoryId])
  @@index([brandId])
  @@index([storeId])
  @@map("products")
}

// Buyer reviews (otziv) — a star rating + comment + an optional photo the
// buyer attaches (e.g. a photo of themselves wearing the item). A user can
// leave multiple reviews for the same product (e.g. after buying it again,
// or updating their opinion) — each submission creates a new row rather
// than overwriting a previous one. Product.rating and Product.reviewsCount
// are recalculated from this table every time a review is created/deleted
// (see review.service.ts), so those two fields stay accurate instead of
// being static/manually-set numbers.
model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// Stock tracked per size+color combination (e.g. "M / Qora" might have 3
// left while "M / Oq" has 0). `Product.stock` stays as an aggregate total
// (kept in sync in product.service.ts) so existing dashboard/low-stock
// code that only reads Product.stock keeps working unchanged; this table
// is the source of truth for "is this specific size+color available".
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
  @@map("product_variants")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, size, color])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Order {
  id              String   @id @default(uuid())
  orderNumber     String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  status          String   @default("PENDING")
  totalAmount     Float
  deliveryAddress String
  deliveryCity    String?
  phone           String
  note            String?
  paymentMethod   String   @default("CASH")
  paymentStatus   String   @default("PENDING")
  // Set once the buyer opens the Telegram bot's deep link (?start=order_<id>)
  // — lets the bot recognize which order a later screenshot belongs to, and
  // lets it message the buyer back once the admin approves/rejects it.
  telegramChatId  String?
  // Language the buyer picked on the bot's /start language-select keyboard —
  // used so later bot messages for this order (receipt received, payment
  // confirmed/rejected) reply in the same language instead of always Uzbek.
  telegramLang    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  title     String
  price     Float
  size      String?
  color     String?
  quantity  Int     @default(1)

  @@map("order_items")
}

// Singleton row (id is always the literal "singleton") holding site-wide
// settings that used to be hardcoded in the frontend — currently just the
// home page hero/banner image, editable from the admin panel instead of a
// developer having to replace a file in the repo.
model SiteSettings {
  id        String   @id @default("singleton")
  heroImage String?
  // Contact page details — editable from the admin panel instead of being
  // hardcoded in the frontend. Null until an admin fills them in for the
  // first time; the Contact page falls back to the original hardcoded
  // values in that case so nothing breaks before this is set up.
  contactAddress  String?
  contactPhone    String?
  contactTelegram String?
  contactEmail    String?
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String
  transactionId String?
  amount        Float
  status        String   @default("PENDING")
  // JSON-encoded string of the raw webhook payload (SQLite has no Json type).
  rawPayload    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payments")
}
